@PACKAGE_INIT@

# IkemenSaturn - installed CMake package.
#
#   find_package(IkemenSaturn CONFIG REQUIRED)
#   find_package(LibSaturn CONFIG REQUIRED)
#   target_link_libraries(my_game PRIVATE IkemenSaturn::IkemenSaturn)
#   ikemen_saturn_configure_executable(my_game)
#   libsaturn_add_binary(my_game)
#   libsaturn_add_disc(my_game ROOT_DIRS data)
#
# Targets: IkemenSaturn::IkemenSaturn (use this)

# Core contains C++; a project that only enabled C still needs CXX for the link.
get_property(_ikemen_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
foreach(_ikemen_lang C CXX)
    if(NOT _ikemen_lang IN_LIST _ikemen_languages)
        enable_language(${_ikemen_lang})
    endif()
endforeach()
unset(_ikemen_languages)
unset(_ikemen_lang)

include("${CMAKE_CURRENT_LIST_DIR}/IkemenSaturnTargets.cmake")

set_and_check(IkemenSaturn_INCLUDE_DIR "@PACKAGE_IKEMEN_INSTALL_INCLUDEDIR_ABS@")
set(IkemenSaturn_VERSION "@PROJECT_VERSION@")

include("${CMAKE_CURRENT_LIST_DIR}/IkemenSaturnFunctions.cmake")

check_required_components(IkemenSaturn)